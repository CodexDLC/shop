# Copy privately to /srv/shop/shared/.env.staging; chmod 600. Never commit real values.
# Use this SAME file for Compose --env-file and SHOP_ENV_FILE.
SHOP_ENV_FILE=/srv/shop/shared/.env.staging
SHOP_RELEASE=staging-initial
DJANGO_SECRET_KEY=
POSTGRES_DB=shop_staging
POSTGRES_USER=shop_staging
POSTGRES_PASSWORD=
# Generate a Fernet key; retain safely with database backups. Comma-separated keys for rotation.
SHOP_MFA_ENCRYPTION_KEYS=
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_NOTIFICATION_VERIFICATION_TOKEN=
EBAY_OAUTH_RUNAME=
EBAY_OAUTH_BASE_URL=https://shop.pinlite.dev
# Separate Fernet key, not the MFA key. Keep safely with the shop database backup.
EBAY_OAUTH_ENCRYPTION_KEYS=
