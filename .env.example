# Copy to .env for local Compose. Set secrets yourself; do not commit .env.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_SETTINGS_MODULE=web.config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=inet_mag
POSTGRES_USER=inet_mag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Payments and eBay writes have no implementation in this foundation.

# Required dedicated Fernet key for MFA secrets. Generate locally; never commit it.
# See docs/project/identity-and-mfa.md for backup and rotation requirements.
SHOP_MFA_ENCRYPTION_KEYS=
