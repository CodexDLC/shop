# Copy to .env for local Compose. Set secrets yourself; do not commit .env.
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
DJANGO_SETTINGS_MODULE=web.config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
POSTGRES_DB=inet_mag
POSTGRES_USER=inet_mag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
# Payments and eBay writes have no implementation in this foundation.

# Required dedicated Fernet key for MFA secrets. Generate locally; never commit it.
# See docs/project/identity-and-mfa.md for backup and rotation requirements.
SHOP_MFA_ENCRYPTION_KEYS=

# eBay: read-only use; seller authorization and outbound writes are not enabled.
EBAY_APP_ID=
EBAY_DEV_ID=
EBAY_CERT_ID=
EBAY_OAUTH_RUNAME=
EBAY_OAUTH_BASE_URL=https://shop.pinlite.dev
EBAY_OAUTH_ENCRYPTION_KEYS=
EBAY_NOTIFICATION_ENDPOINT=
EBAY_NOTIFICATION_VERIFICATION_TOKEN=

# Inventory expiry: keep disabled until schema, dedicated staff actor and permissions are ready.
# Share one dedicated random token (at least 32 characters) between web and worker; never commit it.
INVENTORY_EXPIRY_ENABLED=0
INVENTORY_EXPIRY_TOKEN=
INVENTORY_EXPIRY_ACTOR_ID=
INVENTORY_EXPIRY_BATCH_SIZE=100
# Internal Compose transport; use HTTPS when the worker/backend are on separate hosts.
INVENTORY_EXPIRY_URL=http://web:8000/internal/inventory/expiry/

# Explicit TEST checkout stock source. Keep demo until inventory schema and verified stock are ready.
# inventory_test uses actual StockBalance and never falls back to demo_quantity.
SHOP_CHECKOUT_STOCK_MODE=demo
# TEST-only hold duration, 60..3600 seconds; no live payment policy is implied.
SHOP_CHECKOUT_RESERVATION_TTL_SECONDS=1800
